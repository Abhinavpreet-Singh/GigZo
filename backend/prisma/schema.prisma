generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  Zomato
  Swiggy
  Zepto
  Blinkit
  Amazon
  Other
}

enum WorkerType {
  full_time @map("full-time")
  part_time @map("part-time")
}

enum ActivePlan {
  basic
  pro
}

enum PolicyStatus {
  active
  expired
  cancelled
}

enum ClaimStatus {
  pending
  fraud_check
  approved
  rejected
  paid
  partial
}

enum PayoutStatus {
  initiated
  success
  failed
}

model User {
  id          Int            @id @default(autoincrement())
  firebaseUid String         @unique @map("firebaseUid")
  phone       String         @unique
  email       String?        @unique
  name        String?
  lastLoginAt DateTime?      @default(now()) @map("lastLoginAt") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updatedAt") @db.Timestamptz(6)
  profile     WorkerProfile?
  policies    Policy[]
  claims      Claim[]
  fraudChecks FraudCheck[]
  payouts     Payout[]

  @@map("users")
}

model WorkerProfile {
  userId               Int       @id @map("userId")
  age                  Int?
  platform             Platform?
  workerId             String?   @unique @map("workerId")
  type                 WorkerType?
  city                 String?
  zone                 String?
  pincode              String?
  workingArea          String?   @map("workingArea")
  workingHoursPerDay   Int?      @map("workingHoursPerDay")
  avgDailyEarning      Float?    @default(0) @map("avgDailyEarning")
  riskScore            Float     @default(0) @map("riskScore")
  isProtected          Boolean   @default(false) @map("isProtected")
  activePlan           ActivePlan? @default(basic) @map("activePlan")
  coveragePerDay       Float?    @default(0) @map("coveragePerDay")
  deviceFingerprint    Json?     @map("deviceFingerprint")
  lastLocation         Json?     @map("lastLocation")
  lastActivityAt       DateTime? @default(now()) @map("lastActivityAt") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updatedAt") @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

model DisruptionTrigger {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  description    String?
  parameterType  String?   @map("parameterType")
  thresholdValue Float?    @map("thresholdValue")
  operator       String    @default(">")
  zoneRestricted Boolean   @default(false) @map("zoneRestricted")
  isActive       Boolean   @default(true) @map("isActive")
  createdAt      DateTime  @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updatedAt") @db.Timestamptz(6)
  claims         Claim[]

  @@map("disruption_triggers")
}

model Policy {
  id                   Int          @id @default(autoincrement())
  policyNumber         String       @unique @map("policyNumber")
  userId               Int          @map("userId")
  startDate            DateTime     @map("startDate") @db.Date
  endDate              DateTime     @map("endDate") @db.Date
  premiumAmount        Decimal      @map("premiumAmount") @db.Decimal(12, 2)
  coverageAmount       Decimal      @map("coverageAmount") @db.Decimal(12, 2)
  status               PolicyStatus @default(active)
  riskAdjustmentFactor Float        @default(1) @map("riskAdjustmentFactor")
  createdAt            DateTime     @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updatedAt") @db.Timestamptz(6)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims               Claim[]

  @@map("policies")
}

model Claim {
  id                  Int               @id @default(autoincrement())
  claimNumber         String            @unique @map("claimNumber")
  policyId            Int               @map("policyId")
  userId              Int?              @map("userId")
  triggerId           Int?              @map("triggerId")
  triggeredAt         DateTime          @map("triggeredAt") @db.Timestamptz(6)
  rainfallMm          Float?            @map("rainfallMm")
  aqiValue            Int?              @map("aqiValue")
  temperatureC        Float?            @map("temperatureC")
  otherData           Json?             @map("otherData")
  claimAmount         Decimal           @map("claimAmount") @db.Decimal(12, 2)
  status              ClaimStatus       @default(pending)
  fraudScore          Float             @default(0) @map("fraudScore")
  isFraudSuspected    Boolean           @default(false) @map("isFraudSuspected")
  payoutTransactionId String?           @map("payoutTransactionId")
  paidAt              DateTime?         @map("paidAt") @db.Timestamptz(6)
  evidence            Json?
  notes               String?
  createdAt           DateTime          @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updatedAt") @db.Timestamptz(6)
  policy              Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  trigger             DisruptionTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  fraudChecks         FraudCheck[]
  payouts             Payout[]

  @@map("claims")
}

model FraudCheck {
  id                     Int       @id @default(autoincrement())
  claimId                Int       @map("claimId")
  userId                 Int?      @map("userId")
  gpsValid               Boolean?  @map("gpsValid")
  movementConsistent     Boolean?  @map("movementConsistent")
  deviceIntegrityScore   Float?    @map("deviceIntegrityScore")
  behavioralAnomalyScore Float?    @map("behavioralAnomalyScore")
  locationSpoofDetected  Boolean   @default(false) @map("locationSpoofDetected")
  coordinatedRingDetected Boolean  @default(false) @map("coordinatedRingDetected")
  rawTelemetry           Json?     @map("rawTelemetry")
  modelUsed              String?   @map("modelUsed")
  explanation            String?
  reviewedByAdmin        Boolean   @default(false) @map("reviewedByAdmin")
  adminNotes             String?   @map("adminNotes")
  checkedAt              DateTime? @default(now()) @map("checkedAt") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updatedAt") @db.Timestamptz(6)
  claim                  Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  user                   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("fraud_checks")
}

model ZoneRisk {
  id            Int       @id @default(autoincrement())
  city          String?
  zone          String?
  date          DateTime  @db.Date
  avgRainfallMm Float?    @map("avgRainfallMm")
  maxAqi        Int?      @map("maxAqi")
  avgTempC      Float?    @map("avgTempC")
  heatIndex     Float?    @map("heatIndex")
  disruptionLevel String? @map("disruptionLevel")
  riskScore     Float?    @map("riskScore")
  updatedAt     DateTime  @updatedAt @map("updatedAt") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("createdAt") @db.Timestamptz(6)

  @@unique([city, zone, date])
  @@map("zone_risks")
}

model Payout {
  id               Int          @id @default(autoincrement())
  claimId          Int?         @map("claimId")
  userId           Int?         @map("userId")
  amount           Decimal      @db.Decimal(12, 2)
  status           PayoutStatus
  razorpayPaymentId String?     @map("razorpayPaymentId")
  upiId            String?      @map("upiId")
  paidAt           DateTime?    @map("paidAt") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updatedAt") @db.Timestamptz(6)
  claim            Claim?       @relation(fields: [claimId], references: [id], onDelete: SetNull)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("payouts")
}

model AuditLog {
  id          Int                     @id @default(autoincrement())
  entityType  String?                 @map("entityType")
  entityId    String?                 @map("entityId")
  action      String?
  performedBy Int?                    @map("performedBy")
  oldValues   Json?                   @map("oldValues")
  newValues   Json?                   @map("newValues")
  ipAddress   Unsupported("inet")?   @map("ipAddress")
  createdAt   DateTime                @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updatedAt") @db.Timestamptz(6)

  @@map("audit_logs")
}